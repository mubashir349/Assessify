# Phase 8: settings for docker-compose.yml. Copy to deploy.env (never commit deploy.env).
FLASK_ENV=production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# SQL Server "sa" password: 8+ characters with upper, lower, digit and symbol
DB_PASSWORD=
DB_NAME=AssessifyDB
# the address people open, e.g. https://exam.myuni.edu.pk (used for CORS)
FRONTEND_URL=http://localhost:8000
# true when the site is on https; CSRF protection on for production
JWT_COOKIE_SECURE=false
JWT_COOKIE_CSRF=true
# 1 when a proxy / tunnel / Azure sits in front of the app
TRUST_PROXY_HOPS=0
# Super Admin created by: docker compose exec app python seed.py
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
AI_PROVIDER=none
GEMINI_API_KEY=
MAIL_BACKEND=console
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
