# Copy this file to ".env" and fill in YOUR values. Never commit ".env".

FLASK_ENV=development
SECRET_KEY=4c15c34134bb502754680ef5ad60997c58af3966006bb199c8e9087c8e69d01a
FRONTEND_URL=http://127.0.0.1:5500

# --- SQL Server (pick ONE of the two styles) ---
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhostss
DB_NAME=AssessifyDB

# Style A: Windows login (easiest on your own PC)
DB_TRUSTED=yes
DB_USER=
DB_PASSWORD=

# Style B: SQL login (set DB_TRUSTED=no and fill these)
# DB_TRUSTED=no
# DB_USER=sa
# DB_PASSWORD=YourStrong!Passw0rd

# --- Login cookie ---
JWT_HOURS=8
JWT_COOKIE_SECURE=false      # true once the site runs on https
JWT_COOKIE_CSRF=false        # true in production

# --- Super Admin (used by: python seed.py). Leave password empty to be asked in the terminal. ---
SUPER_ADMIN_EMAIL=superadmin@assessai.com
SUPER_ADMIN_NAME=Platform Super Admin
SUPER_ADMIN_PASSWORD=

# ============ Phase 3: PDF upload + AI question generation ============
# Upload limit for the PDF (MB) and how much of it is used
MAX_UPLOAD_MB=10
PDF_MAX_PAGES=150
PDF_MIN_TEXT_CHARS=300
AI_MAX_SOURCE_CHARS=12000
MAX_QUESTIONS_PER_ATTEMPT=30

# Which FREE AI service writes the draft questions: gemini | groq | ollama | none
#   gemini -> free key from https://aistudio.google.com/app/apikey (no payment method needed)
#   groq   -> free key from https://console.groq.com/keys
#   ollama -> free local model on your PC (https://ollama.com), no key
#   none   -> AI off: generation shows "not configured", review + bank still work
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Leave empty to use the defaults (gemini-3.5-flash-lite / openai/gpt-oss-20b / qwen2.5:7b)
AI_MODEL=
# Leave empty unless Ollama runs on another address (default http://localhost:11434/v1)
AI_BASE_URL=
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_BATCH_SIZE=10
# Optional cap on the AI's answer length (tokens); empty = provider default
AI_MAX_OUTPUT_TOKENS=

# ============ Phase 5: candidate sign-in (access code + date of birth) ============
CANDIDATE_SESSION_HOURS=12            # a candidate stays signed in at most this long (and never past test end + 1 h)
CANDIDATE_LOGIN_MAX_FAILS=5           # wrong date-of-birth tries per access code ...
CANDIDATE_LOGIN_MAX_FAILS_PER_IP=50   # ... and per network address (an exam hall shares one) ...
CANDIDATE_LOGIN_WINDOW_SECONDS=900    # ... within 15 minutes, then 429 TOO_MANY_ATTEMPTS
